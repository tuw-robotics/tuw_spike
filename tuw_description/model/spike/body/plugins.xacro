<robot xmlns:xacro="http://ros.org/wiki/xacro">
    <gazebo>
        <plugin
            filename="libignition-gazebo-joint-state-publisher-system.so"
            name="ignition::gazebo::systems::JointStatePublisher">

            <topic>${namespace}/joint_state</topic>
        </plugin>
        <plugin
            filename="libignition-gazebo-diff-drive-system.so"
            name="ignition::gazebo::systems::DiffDrive">

            <!-- wheels -->
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>
            


            <wheel_separation>${base_width}</wheel_separation>
            <wheel_radius>${wheel_radius}</wheel_radius>

            <frame_id>odom</frame_id>
            <child_frame_id>base_link</child_frame_id>
            
            <odom_publish_frequency>10</odom_publish_frequency>

            <!-- output --> 
            <odom_topic>${namespace}/odom</odom_topic>
            <topic>${namespace}/cmd_vel</topic>
            <tf_topic>${namespace}/tf</tf_topic>

            <!-- limits -->
            <min_linear_velocity>-0.95</min_linear_velocity>
            <max_linear_velocity>0.95</max_linear_velocity>
            <min_angular_velocity>-10.0</min_angular_velocity>
            <max_angular_velocity>10.0</max_angular_velocity>
            <min_linear_acceleration>-5.0</min_linear_acceleration>
            <max_linear_acceleration>3.0</max_linear_acceleration>
            <min_angular_acceleration>-50.0</min_angular_acceleration>
            <max_angular_acceleration>50.0</max_angular_acceleration>
        </plugin>
    </gazebo>
</robot>
<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

    <joint name="camera_joint" type="fixed">
        <origin 
            xyz="${camera_x} ${camera_y} ${camera_z}" 
            rpy="0 ${camera_angle * PI/180} 0"/>
        <parent link="base_link"/>
        <child link="camera"/>
    </joint>

    <link name="camera">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${camera_length} ${camera_width} ${camera_height}"/>
            </geometry>
            <material name="green"/>
        </visual>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="${camera_mass}" />
            <!-- intertia for a box -->
            <inertia
                ixx="${camera_mass / 12.0 * (camera_length*camera_length + camera_height*camera_height)}"
                iyy="${camera_mass / 12.0 * (camera_height*camera_height + camera_width*camera_width)}"
                izz="${camera_mass / 12.0 * (camera_width*camera_width + camera_length*camera_length)}"
                ixy="0.0" ixz="0.0" iyz="0.0" />
        </inertial>
    </link>

    <link name="camera_optical"/>
    <joint name="camera_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
        <parent link="camera"/>
        <child link="camera_optical"/>
    </joint>

    <gazebo reference="camera">
        <sensor type="camera" name="camera_sensor">
            <camera>
                <horizontal_fov>${120.0 * PI/180}</horizontal_fov>
                <image>
                    <width>1280</width>
                    <height>720</height>
                </image>
                <clip>
                    <near>0.005</near>
                    <far>2</far>
                </clip>
            </camera>
            <always_on>1</always_on>
            <update_rate>30</update_rate>
            <visualize>true</visualize>
            <topic>${namespace}/camera</topic>
        </sensor>

    </gazebo>


</robot>
<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tuw_libcamera</name>
  <version>1.0.0</version>
  <description>Composable ROS 2 nodes that capture images from a libcamera-supported camera (e.g. a Raspberry Pi camera module) and republish them through image_transport.</description>
  <maintainer email="markus.bader@tuwien.ac.at">Markus Bader</maintainer>
  <author email="jakob.buchsteiner@gmail.com">Jakob Buchsteiner</author>
  <author email="markus.bader@tuwien.ac.at">Markus Bader</author>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>image_transport</depend>
  <depend>camera_info_manager</depend>
  <depend>generate_parameter_library</depend>

  <exec_depend>image_transport_plugins</exec_depend>
  
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

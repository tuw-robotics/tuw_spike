<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tuw_spike_control</name>
  <version>1.0.0</version>
  <description>ros2_control hardware interface and control nodes for tuw_spike's drive motors, driven through a Raspberry Pi Build HAT over a direct C++/Boost.Asio serial link.</description>
  <maintainer email="markus.bader@tuwien.ac.at">Markus Bader</maintainer>
  <author email="e12125448@student.tuwien.ac.at">Daniel Marth</author>
  <author email="markus.bader@tuwien.ac.at">Markus Bader</author>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS2 packages -->
  <depend>generate_parameter_library</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>geometry_msgs</depend>
  
  <exec_depend>ros2_control</exec_depend>
  <exec_depend>ros2_controllers</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

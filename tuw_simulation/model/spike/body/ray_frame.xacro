<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

    <joint name="ray_origin_joint" type="fixed">
        <origin 
            xyz="${ray_origin_offset} 0 0" 
            rpy="0 0 0"/>
        <!-- TODO footprint and base_link are swapped?-->
        <parent link="base_link"/>
        <child link="ray_origin"/>
    </joint>

    <link name="ray_origin"/>

</robot>
    <!-- x nach vorne | y breite | z höhe -->



    <!-- wheel -->
    <xacro:property name="wheel_x" value="-0.07874"/>
    <xacro:property name="wheel_z" value="-0.015748"/>
    <xacro:property name="wheel_y" value="0.055118"/>
    <xacro:property name="wheel_diameter" value="0.055"/> <!-- lego diameter 56mm -->
    <xacro:property name="wheel_radius" value="${wheel_diameter/2}"/>
    <xacro:property name="wheel_len" value="0.0137"/> <!-- lego len 14mm -->
    <xacro:property name="wheel_mass" value="0.1"/> <!-- kein gewicht von lego noch abwiegen-->

    <!-- Caster wheel -->
    <xacro:property name="caster_z" value="-0.033858"/>
    <xacro:property name="caster_x" value="0.05512"/>
    <xacro:property name="caster_y" value="0"/>
    <xacro:property name="caster_diameter" value="0.0188"/>
    <xacro:property name="caster_radius" value="${caster_diameter/2}"/>
    <xacro:property name="caster_mass" value="0.05"/>

    <!-- base Chassis -->
    <!-- Werte sind nur vorrübergehend -->
    <xacro:property name="base_mass" value="0.7"/>
    <xacro:property name="base_width" value="${wheel_y * 2}"/>
    <xacro:property name="base_length" value="0.170"/>
    <xacro:property name="base_height" value="0.09"/>



</robot>
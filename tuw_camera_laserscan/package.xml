<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tuw_camera_laserscan</name>
  <version>1.0.0</version>
  <description>Camera-image ray localizer for tuw_spike: matches rays cast from the camera image against a known occupancy-grid map to estimate the robot pose.</description>
  <maintainer email="markus.bader@tuwien.ac.at">Markus Bader</maintainer>
  <author email="jakob.buchsteiner@gmail.com">Jakob Buchsteiner</author>
  <author email="markus.bader@tuwien.ac.at">Markus Bader</author>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>image_transport</depend>
  <depend>cv_bridge</depend>
  <depend>tf2</depend>

  <exec_depend>tuw_libcamera</exec_depend>
  <exec_depend>image_pipeline</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
